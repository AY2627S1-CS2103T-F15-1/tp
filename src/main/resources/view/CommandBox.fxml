<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.StackPane?>

<StackPane styleClass="stack-pane command-box" xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1">
  <TextField fx:id="commandTextField" onAction="#handleCommandEntered" promptText="Enter command here..."/>
  <Button fx:id="clearCommandButton" accessibleText="Clear command" mnemonicParsing="false"
          onAction="#handleClearCommand" styleClass="clear-command" StackPane.alignment="CENTER_RIGHT">
    <tooltip><Tooltip text="Clear command" /></tooltip>
  </Button>
</StackPane>

