<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <VBox alignment="CENTER_LEFT" minHeight="60" HBox.hgrow="ALWAYS">
    <padding>
      <Insets top="5" right="5" bottom="5" left="15" />
    </padding>
    <HBox spacing="5" alignment="CENTER_LEFT">
      <Label fx:id="number" styleClass="row-number">
        <minWidth>
          <!-- Ensures that the label text is never truncated -->
          <Region fx:constant="USE_PREF_SIZE" />
        </minWidth>
      </Label>
      <Label fx:id="title" styleClass="row-title" />
    </HBox>
    <Label fx:id="student" styleClass="row-detail" />
    <Label fx:id="due" styleClass="row-detail" />
    <Label fx:id="feedback" styleClass="row-feedback" wrapText="true" />
  </VBox>
  <HBox fx:id="actions" alignment="TOP_RIGHT" spacing="2">
    <padding>
      <Insets top="4" right="6" />
    </padding>
  </HBox>
</HBox>
