<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<HBox fx:id="bar" alignment="CENTER_LEFT" spacing="8" styleClass="confirm-bar"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="6" right="10" bottom="6" left="10" />
  </padding>
  <Label fx:id="question" maxWidth="Infinity" styleClass="confirm-bar-text" wrapText="true"
         HBox.hgrow="ALWAYS" />
  <Button fx:id="confirmButton" defaultButton="false" mnemonicParsing="false" onAction="#handleConfirm"
          styleClass="confirm-bar-confirm" text="Confirm" />
  <Button fx:id="cancelButton" cancelButton="false" mnemonicParsing="false" onAction="#handleCancel"
          styleClass="confirm-bar-cancel" text="Cancel" />
</HBox>
