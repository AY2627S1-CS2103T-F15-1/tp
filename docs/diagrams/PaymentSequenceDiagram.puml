@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":PaymentCommandParser" as PaymentCommandParser LOGIC_COLOR
participant "p:PaymentCommand" as PaymentCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "ab:ReadOnlyAddressBook" as ReadOnlyAddressBook MODEL_COLOR
participant "<<class>>\nLedgerEntry" as LedgerEntry MODEL_COLOR
participant "<<class>>\nLedger" as Ledger MODEL_COLOR
end box

box "<color:#806600>Storage</color>" STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> LogicManager : execute("pay st/1 amt/50.00")
activate LogicManager
LogicManager -> AddressBookParser : parseCommand("pay st/1 amt/50.00")
activate AddressBookParser
AddressBookParser -> PaymentCommandParser : parse("st/1 amt/50.00")
activate PaymentCommandParser
create PaymentCommand
PaymentCommandParser -> PaymentCommand : PaymentCommand(index, amount, date, notes, clock)
activate PaymentCommand
PaymentCommand --> PaymentCommandParser
deactivate PaymentCommand
PaymentCommandParser --> AddressBookParser : p
deactivate PaymentCommandParser
AddressBookParser --> LogicManager : p
deactivate AddressBookParser

LogicManager -> Model : getAddressBook()
activate Model
Model --> LogicManager : ab
deactivate Model
LogicManager -> Storage : snapshotAddressBook(ab)
activate Storage
Storage --> LogicManager : before
deactivate Storage

LogicManager -> PaymentCommand : execute(m)
activate PaymentCommand
PaymentCommand -> Model : getFilteredPersonList()
Model --> PaymentCommand : displayed students
PaymentCommand -> LedgerEntry : payment(student, amount, date, notes)
activate LedgerEntry
LedgerEntry --> PaymentCommand : immutable PAYMENT entry
deactivate LedgerEntry
PaymentCommand -> Model : addLedgerEntry(entry)
Model --> PaymentCommand
PaymentCommand -> Model : getAddressBook()
Model --> PaymentCommand : ab
PaymentCommand -> Ledger : balance(ab, student)
activate Ledger
Ledger -> ReadOnlyAddressBook : getLedgerEntries()
ReadOnlyAddressBook --> Ledger : entries
Ledger --> PaymentCommand : updated balance
deactivate Ledger
create CommandResult
PaymentCommand -> CommandResult : CommandResult(payment confirmation and balance)
activate CommandResult
CommandResult --> PaymentCommand
deactivate CommandResult
PaymentCommand --> LogicManager : result
deactivate PaymentCommand

LogicManager -> Model : getAddressBook()
activate Model
Model --> LogicManager : ab
deactivate Model
LogicManager -> Storage : snapshotAddressBook(ab)
activate Storage
Storage --> LogicManager : after
deactivate Storage
LogicManager -> Storage : saveAddressBook(ab)
activate Storage
Storage --> LogicManager : saved
deactivate Storage
[<--LogicManager : result
deactivate LogicManager
@enduml
