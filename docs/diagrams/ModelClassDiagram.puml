@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class AddressBook
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class Name
Class Phone
Class Email
Class Level
Class Subject
Class Rate
Class Venue
Class Remark

Class UniqueLessonList
Class Lesson
Class LessonDate
Class LessonTime
Class LessonDuration
Class LessonStatus

package Finance {
Class LedgerEntry
Class Ledger
Class Due
}

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

AddressBook .up.|> ReadOnlyAddressBook

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyAddressBook
ModelManager -left-> "1" AddressBook
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

AddressBook *--> "1" UniquePersonList
AddressBook *--> "1" UniqueLessonList
AddressBook *--> "0..*" LedgerEntry : records
UniquePersonList --> "~* all" Person
Person *--> Name
Person *--> Phone
Person *--> "0..1" Email
Person *--> Level
Person *--> "1..*" Subject
Person *--> Rate
Person *--> "0..1" Venue
Person *--> Remark

UniqueLessonList --> "~* all" Lesson
Lesson *--> LessonDate
Lesson *--> LessonTime
Lesson *--> LessonDuration
Lesson *--> LessonStatus
Lesson *--> "0..1" Venue
Lesson ..> Person : refers to its\nstudent by name\nand phone

LedgerEntry ..> Person : studentId
LedgerEntry ..> Lesson : optional lessonId\n(charges only)
Ledger ..> ReadOnlyAddressBook : reads records
Ledger ..> LedgerEntry : calculates from
Due --> Person : student
Ledger ..> Due : returns

note right of LedgerEntry
  Immutable financial event:
  id, studentId, optional lessonId,
  kind, positive amount, date,
  optional notes
  CHARGE entries reference a lesson;
  PAYMENT entries do not.
end note

note right of Ledger
  balance = charges - payments
  dues allocates payments FIFO
  and returns positive unpaid rows.
end note

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Email
Email -[hidden]right-> Level
Level -[hidden]right-> Subject
Subject -[hidden]right-> Rate
Rate -[hidden]right-> Venue
Venue -[hidden]right-> Remark

ModelManager --> "~* filtered" Person
ModelManager --> "~* filtered" Lesson
@enduml
