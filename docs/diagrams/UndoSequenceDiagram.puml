@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "u:UndoCommand" as UndoCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
participant "s:UndoSnapshot" as UndoSnapshot MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

== A destructive command is executed ==

[-> LogicManager : execute("delete 1 confirm")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("delete 1 confirm")
activate AddressBookParser
create DeleteCommand
AddressBookParser -> DeleteCommand
activate DeleteCommand
DeleteCommand --> AddressBookParser
deactivate DeleteCommand
AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> DeleteCommand : undoLabel()
activate DeleteCommand
DeleteCommand --> LogicManager : "student deletion"
deactivate DeleteCommand

LogicManager -> LogicManager : copy the data of m
activate LogicManager
deactivate LogicManager

LogicManager -> DeleteCommand : execute(m)
activate DeleteCommand
DeleteCommand -> Model : deletePerson(student)
activate Model
Model --> DeleteCommand
deactivate Model
DeleteCommand --> LogicManager : r
deactivate DeleteCommand

opt the saved representation of the data changed
    create UndoSnapshot
    LogicManager -> UndoSnapshot : UndoSnapshot("student deletion", copy)
    activate UndoSnapshot
    UndoSnapshot --> LogicManager : s
    deactivate UndoSnapshot

    LogicManager -> Model : setUndoSnapshot(s)
    activate Model
    Model --> LogicManager
    deactivate Model
end

LogicManager -> Storage : saveAddressBook(data)
activate Storage
Storage --> LogicManager
deactivate Storage

[<-- LogicManager : r
deactivate LogicManager

== undo restores the data ==

[-> LogicManager : execute("undo")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("undo")
activate AddressBookParser
create UndoCommand
AddressBookParser -> UndoCommand
activate UndoCommand
UndoCommand --> AddressBookParser
deactivate UndoCommand
AddressBookParser --> LogicManager : u
deactivate AddressBookParser

LogicManager -> UndoCommand : execute(m)
activate UndoCommand

UndoCommand -> Model : getUndoSnapshot()
activate Model
Model --> UndoCommand : s
deactivate Model

UndoCommand -> Model : setAddressBook(data of s)
activate Model
Model --> UndoCommand
deactivate Model

UndoCommand -> Model : clearUndoSnapshot()
activate Model
Model --> UndoCommand
deactivate Model

UndoCommand --> LogicManager : r
deactivate UndoCommand

LogicManager -> Storage : saveAddressBook(data)
activate Storage
Storage --> LogicManager
deactivate Storage

[<-- LogicManager : r
deactivate LogicManager
@enduml
