@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "AddressBook Storage" #F4F6F6{
Class JsonAddressBookStorage
Class VersionedAddressBookStorage
Class StorageSchema
Class DataFileRecovery
Class JsonSerializableAddressBook
Class JsonAdaptedPerson
Class JsonAdaptedSubject
Class JsonAdaptedLesson
Class JsonAdaptedHomework
Class JsonAdaptedLedgerEntry
Class JsonAdaptedTask
}

}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonAddressBookStorage

VersionedAddressBookStorage -up-|> JsonAddressBookStorage
JsonAddressBookStorage ..> JsonSerializableAddressBook
JsonAddressBookStorage ..> StorageSchema : checks the version
JsonAddressBookStorage ..> DataFileRecovery : sets aside\nunreadable files
JsonSerializableAddressBook --> "*" JsonAdaptedPerson
JsonSerializableAddressBook --> "*" JsonAdaptedLesson
JsonSerializableAddressBook --> "*" JsonAdaptedHomework
JsonSerializableAddressBook --> "*" JsonAdaptedLedgerEntry
JsonSerializableAddressBook --> "*" JsonAdaptedTask
JsonAdaptedPerson --> "*" JsonAdaptedSubject

@enduml
