@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":LessonCommandParser" as LessonCommandParser LOGIC_COLOR
participant ":LessonRepeatCommandParser" as LessonRepeatCommandParser LOGIC_COLOR
participant "r:LessonRepeatCommand" as LessonRepeatCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("lesson repeat st/1 d/2026-10-29 t/16:00 count/4")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("lesson repeat ...")
activate AddressBookParser

AddressBookParser -> LessonCommandParser : parse(" repeat st/1 ...")
activate LessonCommandParser

LessonCommandParser -> LessonRepeatCommandParser : parse(" st/1 d/2026-10-29 t/16:00 count/4")
activate LessonRepeatCommandParser

create LessonRepeatCommand
LessonRepeatCommandParser -> LessonRepeatCommand : LessonRepeatCommand(1, ..., count = 4, every = 1)
activate LessonRepeatCommand
LessonRepeatCommand --> LessonRepeatCommandParser
deactivate LessonRepeatCommand

LessonRepeatCommandParser --> LessonCommandParser : r
deactivate LessonRepeatCommandParser
LessonCommandParser --> AddressBookParser : r
deactivate LessonCommandParser
AddressBookParser --> LogicManager : r
deactivate AddressBookParser

LogicManager -> LessonRepeatCommand : execute(m)
activate LessonRepeatCommand

LessonRepeatCommand -> Model : getFilteredPersonList()
activate Model
Model --> LessonRepeatCommand : student
deactivate Model

LessonRepeatCommand -> LessonRepeatCommand : buildSeries(student)
activate LessonRepeatCommand
note right of LessonRepeatCommand : Makes 4 lessons, one per week,\nall with the same seriesId
LessonRepeatCommand --> LessonRepeatCommand : series
deactivate LessonRepeatCommand

loop for each lesson in series
    LessonRepeatCommand -> Model : hasLesson(lesson)
    activate Model
    Model --> LessonRepeatCommand : false
    deactivate Model
end

loop for each lesson in series
    LessonRepeatCommand -> Model : getConflictingLessons(lesson)
    activate Model
    Model --> LessonRepeatCommand : overlapping lessons
    deactivate Model
end

loop for each lesson in series
    LessonRepeatCommand -> Model : addLesson(lesson)
    activate Model
    Model --> LessonRepeatCommand
    deactivate Model
end
note right of LessonRepeatCommand : If addLesson throws, the lessons\nadded so far are deleted again

LessonRepeatCommand --> LogicManager : result
deactivate LessonRepeatCommand

[<--LogicManager : result
deactivate LogicManager
@enduml
