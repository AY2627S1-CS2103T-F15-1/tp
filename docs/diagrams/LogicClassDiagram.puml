@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {

package "Parser Classes" as ParserClasses{
Class PaymentCommandParser
Class BalanceCommandParser
}
Class XYZCommand
Class CommandResult
Class "{abstract}\nCommand" as Command
Class PaymentCommand
Class BalanceCommand
Class DuesCommand
Class LessonDoneCommand


Class "<<interface>>\nLogic" as Logic
Class LogicManager
}

package Model {
Class HiddenModel #FFFFFF
Class Ledger
Class LedgerEntry
}

package Storage {
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Logic

LogicManager .right.|> Logic
LogicManager -right->"1" ParserClasses
ParserClasses ..> XYZCommand : <<create>>

XYZCommand -up-|> Command
PaymentCommand -up-|> Command
BalanceCommand -up-|> Command
DuesCommand -up-|> Command
LessonDoneCommand -up-|> Command
LogicManager .left.> Command : <<call>>

LogicManager --> Model
LogicManager --> Storage
Storage --[hidden] Model
Command .[hidden]up.> Storage
Command .right.> Model
PaymentCommand ..> Model
BalanceCommand ..> Model
DuesCommand ..> Model
LessonDoneCommand ..> Model
PaymentCommandParser ..> PaymentCommand : <<create>>
BalanceCommandParser ..> BalanceCommand : <<create>>
AddressBookParser ..> DuesCommand : <<create>>
PaymentCommand ..> Ledger : records payment\nand reads balance
BalanceCommand ..> Ledger : reads balance
DuesCommand ..> Ledger : formats dues
LessonDoneCommand ..> LedgerEntry : reports charge
PaymentCommand ..> LedgerEntry : creates payment
note right of XYZCommand: XYZCommand = AddCommand, \nFindCommand, etc

Logic ..> CommandResult
LogicManager .down.> CommandResult
Command .up.> CommandResult : <<create>>
@enduml
